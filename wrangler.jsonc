{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildstrike-arena-realtime",
  "main": "party/server.ts",
  "compatibility_date": "2024-09-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "GameRoom",
        "class_name": "GameRoom"
