# Host (no protocol, no trailing slash) of the deployed PartyServer realtime
# backend used for Online 1v1. Bot Duel mode never uses this and works with
# no backend at all.
#
# Local development (matches `npm run party:dev`):
NEXT_PUBLIC_PARTY_HOST=localhost:8787

# Production example, after `npm run party:deploy`:
# NEXT_PUBLIC_PARTY_HOST=buildstrike-arena-realtime.<your-subdomain>.workers.dev
